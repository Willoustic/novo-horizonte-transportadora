# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-64-char-hex-string-here

# Supabase service role (server-side only - used by scripts/vibra-capture.ts, never expose in browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub Actions (used by src/app/api/vibra/capturar/route.ts to dispatch vibra-capture.yml)
GITHUB_TOKEN=your-github-token-or-pat
GITHUB_REPO_OWNER=Willoustic
GITHUB_REPO_NAME=novo-horizonte-transportadora

# Vibra capture email (IMAP para 2FA) — usados por scripts/vibra-capture.ts e GitHub Actions secrets
VIBRA_EMAIL_USER=seu-email@gmail.com
VIBRA_EMAIL_PASS=sua-senha-de-app-do-gmail

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000