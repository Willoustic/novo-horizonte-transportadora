# Variáveis de ambiente para o projeto Transportadora
# Copie este arquivo para .env e preencha com valores reais.
# NÃO commite o arquivo .env com credenciais reais.

# Supabase (obrigatório para API e captura)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Criptografia AES-256 (obrigatório para descriptografar credenciais da Vibra)
ENCRYPTION_KEY=sua-chave-hex-de-64-caracteres

# URL base da aplicacao (producao: https://nh-transportadora.vercel.app)
NEXT_PUBLIC_APP_URL=https://nh-transportadora.vercel.app

# Email para 2FA da Vibra (usado pelo script de captura)
# Valores lidos exclusivamente de env/secrets. Nunca hardcoded no script.
VIBRA_EMAIL_USER=seu-email@gmail.com
VIBRA_EMAIL_PASS=sua-senha-de-app
